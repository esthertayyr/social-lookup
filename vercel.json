{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/lookup", "dest": "/api/lookup.js" },
    { "src": "/api/lookup-email", "dest": "/api/lookup-email.js" },
    { "src": "/api/lookup-phone", "dest": "/api/lookup-phone.js" },
    { "src": "/(.*\\..+)$", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
